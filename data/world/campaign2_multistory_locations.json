      "interaction_rules": [
        {
          "id": "dwarf_king",
          "dialogue_id": "dwarf_king",
          "source": "campaign2Dialogue.js:npcDialogueTrees.dwarf_king",
          "opening_standing_thresholds": [
            {
              "minimum": 30,
              "text": "You've done right by the Deepholds more than once now. Speak freely in my hall."
            },
            {
              "maximum": -10,
              "text": "I know your name, and not from anything I'd call good. Mind your tongue in my hall."
            },
            {
              "default": true,
              "text": "Few surface-dwellers find their way this deep. State your business."
            }
          ],
          "quest_offer": "deepholds_infestation",
          "quest_completion_text": "The lower tunnels have gone quiet the right way, for once. The Deepholds don't forget a debt like that — take this, pulled from the same gallery you cleared. Dornik says it's grown deep enough to be worth something to the right hands."
        },
        {
          "id": "deepholds_foreman",
          "dialogue_id": "deepholds_foreman",
          "source": "campaign2Dialogue.js:npcDialogueTrees.deepholds_foreman",
          "before_quest": "Third gallery's sealed off — something moved in a few weeks back, webbing thick as rope. Lost two crews before I called the retreat. Talk to the King if you're looking for real work.",
          "active_quest_with_tagged_creatures_alive": "Sealed gallery's due north of the hall, straight tunnel. Whatever's in there, it's still in there.",
          "after_tagged_creatures_cleared": "Crews are already back at the vein. Whatever you did down there, it worked."
        },
