root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

# Existing GDScript files use both tabs and spaces. Keep indentation consistent
# within each file; the CI checker rejects mixed indentation in a script.
[*.gd]
indent_size = 4

[*.tscn]
indent_style = tab
indent_size = 4

[*.tres]
indent_style = tab
indent_size = 4

[*.json]
indent_style = space
indent_size = 2
